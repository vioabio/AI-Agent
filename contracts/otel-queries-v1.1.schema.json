{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vio.invalid/contracts/otel-queries-v1.1.schema.json",
  "title": "VIO v1.1 OpenTelemetry query contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "producer", "status", "commit", "queries", "redaction"],
  "properties": {
    "schemaVersion": {"const": "v1.1"},
    "producer": {"const": "export-otel-contract"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "commit": {"type": "string", "minLength": 1},
    "gitCommit": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "blocked"]},
    "queries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/query"}},
    "redaction": {"$ref": "#/$defs/redaction"},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "query": {
      "type": "object",
      "required": ["queryId", "signal", "spanName", "expression", "owner"],
      "properties": {
        "queryId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"},
        "signal": {"enum": ["span", "metric", "log"]},
        "spanName": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "queryOwner": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "redaction": {
      "type": "object",
      "required": ["sensitiveValuesPersisted", "rules"],
      "properties": {
        "sensitiveValuesPersisted": {"const": false},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
