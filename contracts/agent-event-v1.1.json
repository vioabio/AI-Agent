{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vio.invalid/contracts/agent-event-v1.1.json",
  "title": "VIO Agent structured event contract",
  "type": "object",
  "required": ["schemaVersion", "eventId", "type", "sessionId", "runId", "traceId", "timestamp", "payload"],
  "properties": {
    "schemaVersion": {"const": "v1.1"},
    "eventId": {"type": "integer", "format": "int64", "minimum": 1},
    "type": {
      "enum": [
        "context.card",
        "fact.card",
        "calculation.card",
        "team.matrix",
        "activity.card",
        "retrieval.citation.card",
        "answer.completed",
        "feedback.card",
        "error.card"
      ]
    },
    "sessionId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "traceId": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  },
  "$defs": {
    "contextCard": {
      "type": "object",
      "required": ["gameReleaseId", "battleFormatId", "rulesetVersionId", "language"],
      "properties": {
        "gameReleaseId": {"type": "string"},
        "battleFormatId": {"type": "string"},
        "rulesetVersionId": {"type": "string"},
        "language": {"type": "string"}
      }
    },
    "factCard": {
      "type": "object",
      "required": ["factId", "name", "types", "baseStats", "gameReleaseId", "dataReleaseId", "sourceUrl", "evidenceText"],
      "properties": {
        "factId": {"type": "string"},
        "name": {"type": "string"},
        "types": {"type": "array"},
        "baseStats": {"type": "object"},
        "gameReleaseId": {"type": "string"},
        "dataReleaseId": {"type": "string"},
        "sourceUrl": {"type": "string", "format": "uri"},
        "evidenceText": {"type": "string"}
      }
    },
    "calculationCard": {
      "type": "object",
      "required": ["calculationId", "calculationType", "result", "gameReleaseId", "battleFormatId", "rulesetVersionId", "dataReleaseId"]
    },
    "teamMatrix": {
      "type": "object",
      "required": ["teamId", "members", "gameReleaseId", "battleFormatId", "rulesetVersionId", "dataReleaseId"]
    },
    "activityCard": {
      "type": "object",
      "required": ["noticeId", "title", "sourceUrl", "retrievedAt", "effectiveFrom", "freshness", "gameReleaseId"]
    },
    "retrievalCitationCard": {
      "type": "object",
      "required": ["sourceUrl", "evidenceText", "documentVersion", "chunkId", "dataReleaseId", "knowledgeReleaseId", "indexReleaseId"]
    },
    "answerCompleted": {
      "type": "object",
      "required": ["answerId", "lineageStatus"]
    },
    "feedbackCard": {
      "type": "object",
      "required": ["answerId", "feedbackId", "status"]
    },
    "errorCard": {
      "type": "object",
      "required": ["code", "message"]
    }
  }
}
