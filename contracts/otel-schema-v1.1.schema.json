{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vio.invalid/contracts/otel-schema-v1.1.schema.json",
  "title": "VIO v1.1 OpenTelemetry span contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "producer", "status", "commit", "owner", "sampling", "correlation", "spans", "redaction"],
  "properties": {
    "schemaVersion": {"const": "v1.1"},
    "producer": {"const": "export-otel-contract"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "commit": {"type": "string", "minLength": 1},
    "gitCommit": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "queryOwner": {"type": "string", "minLength": 1},
    "status": {"enum": ["ready", "blocked"]},
    "sampling": {"type": "object", "required": ["strategy", "productionRatio", "errorRatio"]},
    "correlation": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
    "redaction": {"$ref": "#/$defs/redaction"},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["name", "requiredAttributes"],
      "properties": {
        "name": {"type": "string", "pattern": "^vio\\.agent\\.[a-z0-9._-]+$"},
        "requiredAttributes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "redaction": {
      "type": "object",
      "required": ["forbiddenAttributeNames", "forbiddenValuePatterns", "sensitiveValuesPersisted"],
      "properties": {
        "forbiddenAttributeNames": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbiddenValuePatterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sensitiveValuesPersisted": {"const": false}
      },
      "additionalProperties": true
    }
  }
}
