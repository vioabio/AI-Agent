{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vio.invalid/contracts/image-secret-scan-v1.1.json",
  "title": "VIO v1.1 immutable image secret scan evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "producer",
    "generatedAt",
    "status",
    "passed",
    "producerCompleted",
    "exitCode",
    "redacted",
    "scanner",
    "images",
    "findings",
    "dependencyCoverage"
  ],
  "properties": {
    "schemaVersion": {"const": "v1.1"},
    "producer": {"const": "scan-image-secrets"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "gitCommit": {"type": ["string", "null"]},
    "status": {"enum": ["environment-pending", "blocked", "passed"]},
    "passed": {"type": "boolean"},
    "producerCompleted": {"type": "boolean"},
    "exitCode": {"type": "integer", "minimum": 0},
    "redacted": {"const": true},
    "secretValuesPersisted": {"const": false},
    "dockerInvoked": {"const": false},
    "registryContacted": {"const": false},
    "scanner": {"$ref": "#/$defs/scanner"},
    "images": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/image"}
    },
    "imageCount": {"type": "integer", "minimum": 0},
    "scanTargets": {"type": "array", "items": {"$ref": "#/$defs/scanTarget"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "findingCount": {"type": "integer", "minimum": 0},
    "dependencyCoverage": {"$ref": "#/$defs/dependencyCoverage"},
    "inputs": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "policy": {"type": "object"},
    "schema": {"type": "object"}
  },
  "$defs": {
    "scanner": {
      "type": "object",
      "required": ["name", "version", "executed", "commandInvoked", "allowlistUsed", "redaction"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "executed": {"const": false},
        "commandInvoked": {"const": false},
        "allowlistUsed": {"const": false},
        "redaction": {"const": "strict"}
      },
      "additionalProperties": true
    },
    "image": {
      "type": "object",
      "required": [
        "name",
        "repoDigest",
        "digest",
        "scannerExecuted",
        "scanComplete",
        "findings",
        "findingCount",
        "exitCode",
        "status",
        "passed",
        "redacted"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,63}$"},
        "repoDigest": {"type": "string", "pattern": "^.+@sha256:[a-fA-F0-9]{64}$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "source": {"type": "string"},
        "scannerVersion": {"type": "string"},
        "scannerExecuted": {"const": false},
        "scanComplete": {"const": false},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "findingCount": {"const": 0},
        "exitCode": {"type": "integer", "minimum": 1},
        "status": {"const": "environment-pending"},
        "passed": {"const": false},
        "redacted": {"const": true}
      },
      "additionalProperties": true
    },
    "scanTarget": {
      "type": "object",
      "required": [
        "name",
        "repoDigest",
        "digest",
        "scannerVersion",
        "scannerExecuted",
        "findings",
        "findingCount",
        "exitCode",
        "status",
        "redacted"
      ],
      "properties": {
        "name": {"type": "string"},
        "repoDigest": {"type": "string", "pattern": "^.+@sha256:[a-fA-F0-9]{64}$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "scannerVersion": {"type": "string"},
        "scannerExecuted": {"const": false},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "findingCount": {"const": 0},
        "exitCode": {"type": "integer", "minimum": 1},
        "status": {"const": "environment-pending"},
        "redacted": {"const": true}
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": ["redacted"],
      "properties": {
        "redacted": {"const": true},
        "image": {"type": "string"},
        "layer": {"type": ["integer", "null"], "minimum": 0},
        "path": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]},
        "severity": {"type": ["string", "null"]},
        "valuePresent": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "dependencyCoverage": {
      "type": "object",
      "required": [
        "inventoryProvided",
        "dependencyCount",
        "imageRequiredCount",
        "digestBoundCount",
        "missingDigestCount",
        "scannedCount",
        "rows"
      ],
      "properties": {
        "inventoryProvided": {"type": "boolean"},
        "dependencyCount": {"type": "integer", "minimum": 0},
        "imageRequiredCount": {"type": "integer", "minimum": 0},
        "digestBoundCount": {"type": "integer", "minimum": 0},
        "missingDigestCount": {"type": "integer", "minimum": 0},
        "scannedCount": {"const": 0},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/dependencyRow"}}
      },
      "additionalProperties": true
    },
    "dependencyRow": {
      "type": "object",
      "required": ["name", "imageRequired", "status", "reason"],
      "properties": {
        "name": {"type": "string"},
        "imageRequired": {"type": "boolean"},
        "repoDigest": {"type": ["string", "null"], "pattern": "^.+@sha256:[a-fA-F0-9]{64}$"},
        "digest": {"type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$"},
        "status": {"enum": ["environment-pending", "blocked", "not-an-image"]},
        "reason": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
