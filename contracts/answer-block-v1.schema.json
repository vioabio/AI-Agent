{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified Pokemon Answer Block v1",
  "$comment": "blockId must additionally equal pokemon-{formId}; runtime validators enforce this. Digest is provenance metadata, not proof of trust by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "blockId",
    "formId",
    "name",
    "types",
    "stats",
    "gameReleaseId",
    "dataReleaseId",
    "evidenceDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "answer-block-v1"
    },
    "kind": {
      "const": "pokemon"
    },
    "blockId": {
      "type": "string",
      "pattern": "^pokemon-[0-9]+$"
    },
    "formId": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10
      }
    },
    "stats": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 255
      }
    },
    "gameReleaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "dataReleaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "evidenceDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
