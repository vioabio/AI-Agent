{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vio.invalid/contracts/release-manifest-v1.1.json",
  "title": "VIO v1.1 release manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "artifactRoot",
    "releaseClass",
    "environment",
    "releaseId",
    "generatedAt",
    "gitCommit",
    "images",
    "migrationVersion",
    "modelVersion",
    "promptVersion",
    "dataReleaseId",
    "knowledgeReleaseId",
    "indexReleaseId",
    "evaluationRunId",
    "embedding",
    "supportMatrix",
    "evidence",
    "rollback",
    "status"
  ],
  "properties": {
    "schemaVersion": {"const": "v1.1"},
    "artifactRoot": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "repoRoot": {"type": "string"},
    "releaseClass": {"enum": ["GA", "DEMO_ONLY", "RC"]},
    "environment": {"enum": ["prod", "staging"]},
    "releaseId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "gitCommit": {"type": "string", "minLength": 1},
    "images": {
      "type": "object",
      "required": ["backend", "frontend"],
      "properties": {
        "backend": {"$ref": "#/$defs/image"},
        "frontend": {"$ref": "#/$defs/image"}
      },
      "additionalProperties": true
    },
    "migrationVersion": {"type": "string", "minLength": 1},
    "modelVersion": {"type": "string", "minLength": 1},
    "promptVersion": {"type": "string", "minLength": 1},
    "dataReleaseId": {"type": "string", "minLength": 1},
    "knowledgeReleaseId": {"type": "string", "minLength": 1},
    "indexReleaseId": {"type": "string", "minLength": 1},
    "evaluationRunId": {"type": "string", "minLength": 1},
    "evaluationRunIds": {"type": "object", "additionalProperties": {"type": "string"}},
    "embedding": {
      "type": "object",
      "required": ["provider", "model", "dimension", "preprocessingProfile", "indexProfile"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "dimension": {"type": "integer", "minimum": 1},
        "preprocessingProfile": {"type": "string", "minLength": 1},
        "indexProfile": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "transportMode": {"enum": ["sse", "long-polling", "websocket"]},
    "supportMatrix": {"type": "object", "minProperties": 1},
    "evidence": {"type": "object"},
    "rollback": {"type": "object"},
    "observationWindowHours": {"type": "number", "minimum": 0},
    "minRequests": {"type": "integer", "minimum": 0},
    "minRequestsPerWindow": {"type": "integer", "minimum": 0},
    "status": {"enum": ["BLOCKED", "RC", "DEMO_ONLY", "GA"]}
  },
  "$defs": {
    "image": {
      "oneOf": [
        {"type": "string", "pattern": "^.+@sha256:[a-fA-F0-9]{64}$"},
        {
          "type": "object",
          "required": ["repoDigest"],
          "properties": {
            "repoDigest": {"type": "string", "pattern": "^.+@sha256:[a-fA-F0-9]{64}$"},
            "digest": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
            "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
