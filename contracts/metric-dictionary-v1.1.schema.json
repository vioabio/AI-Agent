{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vio.invalid/contracts/metric-dictionary-v1.1.schema.json",
  "title": "VIO v1.1 metric dictionary",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "dictionaryVersion", "owner", "status", "metrics"],
  "properties": {
    "schemaVersion": {"const": "v1.1"},
    "dictionaryVersion": {"const": "v1.1"},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "ready", "blocked"]},
    "generatedAt": {"type": ["string", "null"], "format": "date-time"},
    "sourceDictionaryVersion": {"type": ["string", "null"]},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "metricId", "type", "formula", "denominator", "exclusions", "window",
        "minimumSamples", "minRequests", "version", "owner", "alertThreshold",
        "rollbackCondition", "thresholdVersion", "query", "severity"
      ],
      "properties": {
        "metricId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,127}$"},
        "type": {"enum": ["product_kpi", "diagnostic", "slo", "cost"]},
        "formula": {"type": "string", "minLength": 1},
        "denominator": {"type": "string", "minLength": 1},
        "eligibleRequests": {"type": "string", "minLength": 1},
        "exclusions": {"type": "array", "items": {"type": "string"}},
        "window": {"type": "string", "minLength": 1},
        "minimumSamples": {"type": "integer", "minimum": 1},
        "minRequests": {"type": "integer", "minimum": 1},
        "version": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "alertThreshold": {"type": "string", "minLength": 1},
        "rollbackCondition": {"type": "string", "minLength": 1},
        "thresholdVersion": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "severity": {"enum": ["blocker", "warning", "info"]},
        "evaluationPhase": {"enum": ["n6a", "n6b"]},
        "blocking": {"type": "boolean"}
      }
    }
  }
}
