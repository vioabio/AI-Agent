{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vio.invalid/contracts/dependency-inventory-v1.1.json",
  "title": "VIO v1.1 dependency inventory",
  "type": "object",
  "required": ["schemaVersion", "producer", "generatedAt", "status", "dependencies", "redacted"],
  "properties": {
    "schemaVersion": {"const": "v1.1"},
    "producer": {"type": "string", "enum": ["export-dependency-inventory", "prepare-dependency-inventory", "finalize-dependency-inventory"]},
    "generatedAt": {"type": "string", "format": "date-time"},
    "gitCommit": {"type": ["string", "null"]},
    "owner": {"type": ["string", "null"]},
    "status": {"enum": ["draft", "candidate", "environment-pending", "blocked", "ready"]},
    "passed": {"type": "boolean"},
    "producerCompleted": {"type": "boolean"},
    "exitCode": {"type": "integer", "minimum": 0},
    "redacted": {"const": true},
    "baseline": {"type": ["object", "null"]},
    "imageRefs": {"type": ["object", "null"]},
    "releaseImages": {"type": "object"},
    "scan": {"type": ["object", "null"]},
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dependency"}
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "required": ["name", "version", "imageOrEndpointDigest", "source", "healthProbe", "networkBoundary", "requiredStage", "status"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "version": {"type": ["string", "null"]},
        "imageOrEndpointDigest": {"type": ["string", "null"]},
        "repoDigest": {"type": ["string", "null"], "pattern": "^.+@sha256:[a-fA-F0-9]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "healthProbe": {"type": "string", "minLength": 1},
        "networkBoundary": {"type": "string", "minLength": 1},
        "requiredStage": {"type": "string", "minLength": 1},
        "status": {"enum": ["ready", "candidate", "environment-pending", "not-configured", "blocked"]},
        "evidence": {"type": "object"},
        "scan": {"type": ["object", "null"]},
        "sbom": {"type": ["object", "null"]},
        "signature": {"type": ["object", "null"]},
        "attestation": {"type": ["object", "null"]},
        "provenance": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
