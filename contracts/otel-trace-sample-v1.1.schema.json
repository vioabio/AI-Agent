{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vio.invalid/contracts/otel-trace-sample-v1.1.schema.json",
  "title": "VIO v1.1 redacted OpenTelemetry trace sample",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "spans"],
  "properties": {
    "schemaVersion": {"const": "v1.1"},
    "runId": {"type": ["string", "null"]},
    "traceId": {"type": ["string", "null"]},
    "evaluationRunId": {"type": ["string", "null"]},
    "spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
    "redacted": {"const": true}
  },
  "$defs": {
    "span": {
      "type": "object",
      "required": ["schemaVersion", "traceId", "spanId", "name", "startTime", "endTime", "attributes"],
      "properties": {
        "schemaVersion": {"const": "v1.1"},
        "traceId": {"type": "string", "pattern": "^[a-fA-F0-9]{16,128}$"},
        "spanId": {"type": "string", "pattern": "^[a-fA-F0-9]{8,64}$"},
        "name": {"type": "string", "pattern": "^vio\\.agent\\.[a-z0-9._-]+$"},
        "startTime": {"type": "string", "minLength": 1},
        "endTime": {"type": "string", "minLength": 1},
        "attributes": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
