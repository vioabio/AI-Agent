{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Saved cultivation configuration snapshot v1",
  "$comment": "Runtime additionally enforces account/request/expiry binding before projection, Run versions, unique slots/forms, EV total <= 510, and content-derived identity. Saved values may include original defaults; this is not training advice, in-game state or mutation authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "blockId",
    "kind",
    "teamId",
    "revision",
    "teamName",
    "gameReleaseId",
    "dataReleaseId",
    "rulesetVersionId",
    "scope",
    "members"
  ],
  "properties": {
    "schemaVersion": {
      "const": "answer-block-v1"
    },
    "blockId": {
      "type": "string",
      "pattern": "^training-[a-f0-9]{64}$"
    },
    "kind": {
      "const": "trainingPlan"
    },
    "teamId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "teamName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "gameReleaseId": {
      "const": "pokemon-scarlet-violet"
    },
    "dataReleaseId": {
      "const": "pokeapi-reference-v1"
    },
    "rulesetVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "scope": {
      "const": "SAVED_BUILD_SNAPSHOT_NOT_TRAINING_ADVICE"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "pokemon",
          "build"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "pokemon": {
            "$ref": "answer-block-v1.schema.json"
          },
          "build": {
            "$ref": "#/$defs/build"
          }
        }
      }
    }
  },
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moves",
        "ability",
        "item",
        "nature",
        "level",
        "evs",
        "ivs"
      ],
      "properties": {
        "moves": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "ability": {
          "type": "string",
          "maxLength": 80
        },
        "item": {
          "type": "string",
          "maxLength": 80
        },
        "nature": {
          "enum": [
            "hardy",
            "lonely",
            "brave",
            "adamant",
            "naughty",
            "bold",
            "docile",
            "relaxed",
            "impish",
            "lax",
            "timid",
            "hasty",
            "serious",
            "jolly",
            "naive",
            "modest",
            "mild",
            "quiet",
            "bashful",
            "rash",
            "calm",
            "gentle",
            "sassy",
            "careful",
            "quirky"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "evs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hp",
            "atk",
            "def",
            "spa",
            "spd",
            "spe"
          ],
          "properties": {
            "hp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 252
            },
            "atk": {
              "type": "integer",
              "minimum": 0,
              "maximum": 252
            },
            "def": {
              "type": "integer",
              "minimum": 0,
              "maximum": 252
            },
            "spa": {
              "type": "integer",
              "minimum": 0,
              "maximum": 252
            },
            "spd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 252
            },
            "spe": {
              "type": "integer",
              "minimum": 0,
              "maximum": 252
            }
          }
        },
        "ivs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hp",
            "atk",
            "def",
            "spa",
            "spd",
            "spe"
          ],
          "properties": {
            "hp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "atk": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "def": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "spa": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "spd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            },
            "spe": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            }
          }
        },
        "teraType": {
          "enum": [
            null,
            "normal",
            "fire",
            "water",
            "electric",
            "grass",
            "ice",
            "fighting",
            "poison",
            "ground",
            "flying",
            "psychic",
            "bug",
            "rock",
            "ghost",
            "dragon",
            "dark",
            "steel",
            "fairy",
            "stellar"
          ]
        }
      }
    }
  }
}
