FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/src
WORKDIR /app
COPY deploy/requirements-api.txt /tmp/requirements-api.txt
RUN pip install --no-cache-dir -r /tmp/requirements-api.txt
COPY apps /app/apps
COPY src /app/src
COPY config/retrieval_profiles.yaml /app/config/retrieval_profiles.yaml
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin hrweb
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,urllib.error; exec('try:\n urllib.request.urlopen(\"http://127.0.0.1:8000/api/v1/me\",timeout=3)\nexcept urllib.error.HTTPError as e:\n assert e.code == 401')"
CMD ["python", "-m", "uvicorn", "apps.hr_review_api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "172.17.0.1", "--no-access-log"]
