APP_ENV=production
# Configure a dedicated least-privilege account on the server only.
HR_REVIEW_DATABASE_URL=
HR_COOKIE_SECURE=true
# Set HR_ALLOW_HTTP=true and HR_COOKIE_SECURE=false only for explicitly approved HTTP deployment.
HR_ALLOW_HTTP=false
HR_ENABLE_OPENAPI=false
HR_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
HR_BATCH_STATE_PATH=/app/runtime/batches.json
