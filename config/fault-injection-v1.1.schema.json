{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vio.invalid/contracts/fault-injection-v1.1.json",
  "title": "VIO v1.1 fault injection plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "status",
    "owner",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {"const": "v1.1"},
    "planId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
    "status": {"enum": ["pending", "approved", "blocked"]},
    "owner": {"type": "string", "minLength": 1},
    "reviewer": {"type": ["string", "null"]},
    "approvedAt": {"type": ["string", "null"], "format": "date-time"},
    "scenarios": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenarioId",
          "faultType",
          "target",
          "expectedSignals",
          "recoveryAction",
          "maxDurationSeconds"
        ],
        "properties": {
          "scenarioId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
          "faultType": {
            "enum": [
              "model-timeout-5xx",
              "database-unavailable",
              "mcp-disconnect",
              "candidate-index-query-failure"
            ]
          },
          "target": {"type": "string", "minLength": 1},
          "expectedSignals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "recoveryAction": {"type": "string", "minLength": 1},
          "maxDurationSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
          "requiresApproval": {"type": "boolean"}
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistResponseBodies": {"const": false},
        "forbiddenFields": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
