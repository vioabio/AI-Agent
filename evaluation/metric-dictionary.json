{
  "dictionaryVersion": "v1.0.0",
  "owner": "vio-ai-agent",
  "status": "candidate",
  "metrics": [
    {
      "metricId": "fact_task_success_rate",
      "type": "product_kpi",
      "formula": "fully_correct_fact_tasks / eligible_fact_tasks",
      "eligibleRequests": "authenticated fact task with a frozen answer key",
      "exclusions": ["invalid input", "policy rejection", "主动取消"],
      "window": "evaluation_run",
      "minimumSamples": 200,
      "version": "v1.0",
      "owner": "domain",
      "alertThreshold": "< 0.98",
      "rollbackCondition": "candidate release blocked"
    },
    {
      "metricId": "evidence_task_success_rate",
      "type": "product_kpi",
      "formula": "correct_and_supported_answers / eligible_evidence_tasks",
      "eligibleRequests": "RAG task with at least one approved source",
      "exclusions": ["no-evidence cases"],
      "window": "evaluation_run",
      "minimumSamples": 200,
      "version": "v1.0",
      "owner": "knowledge",
      "alertThreshold": "< 0.95",
      "rollbackCondition": "candidate release blocked"
    },
    {
      "metricId": "rules_task_success_rate",
      "type": "product_kpi",
      "formula": "version_and_rules_correct_tasks / eligible_rules_tasks",
      "eligibleRequests": "task with game/ruleset context",
      "exclusions": ["ambiguous context awaiting clarification"],
      "window": "evaluation_run",
      "minimumSamples": 200,
      "version": "v1.0",
      "owner": "domain",
      "alertThreshold": "< 0.98",
      "rollbackCondition": "candidate release blocked"
    },
    {
      "metricId": "no_answer_handling_rate",
      "type": "product_kpi",
      "formula": "correct_refusal_or_clarification / no_answer_cases",
      "eligibleRequests": "frozen no-answer or ambiguous case",
      "exclusions": [],
      "window": "evaluation_run",
      "minimumSamples": 100,
      "version": "v1.0",
      "owner": "quality",
      "alertThreshold": "< 0.90",
      "rollbackCondition": "candidate release blocked"
    },
    {
      "metricId": "correction_p0_on_time_rate",
      "type": "product_kpi",
      "formula": "p0_cases_published_within_24h / due_p0_cases",
      "eligibleRequests": "P0 correction case due in rolling 30 days",
      "exclusions": ["取消或重复 case"],
      "window": "rolling_30d",
      "minimumSamples": 1,
      "version": "v1.0",
      "owner": "operations",
      "alertThreshold": "< 0.95",
      "rollbackCondition": "pause ordinary releases"
    },
    {
      "metricId": "correction_closure_rate",
      "type": "product_kpi",
      "formula": "verified_or_closed_due_cases / all_due_cases",
      "eligibleRequests": "feedback correction case in rolling window",
      "exclusions": [],
      "window": "rolling_30d",
      "minimumSamples": 1,
      "version": "v1.0",
      "owner": "operations",
      "alertThreshold": "< 0.95",
      "rollbackCondition": "pause ordinary releases"
    },
    {
      "metricId": "deterministic_calculation_accuracy",
      "type": "diagnostic",
      "formula": "passed_assertions / total_assertions",
      "eligibleRequests": "all calculation golden cases",
      "exclusions": [],
      "window": "evaluation_run",
      "minimumSamples": 1,
      "version": "v1.0",
      "owner": "domain",
      "alertThreshold": "< 1.0",
      "rollbackCondition": "candidate release blocked immediately"
    },
    {
      "metricId": "rag_recall_at_5",
      "type": "diagnostic",
      "formula": "queries_with_relevant_evidence_in_top5 / eligible_rag_queries",
      "eligibleRequests": "RAG query with labeled evidence chunk",
      "exclusions": ["no-answer cases"],
      "window": "evaluation_run",
      "minimumSamples": 100,
      "version": "v1.0",
      "owner": "knowledge",
      "alertThreshold": "< 0.90",
      "rollbackCondition": "candidate release blocked"
    },
    {
      "metricId": "citation_correctness",
      "type": "diagnostic",
      "formula": "supporting_citations / reviewed_citations",
      "eligibleRequests": "answer citations sampled from approved releases",
      "exclusions": ["fact-only answers without citations"],
      "window": "evaluation_run",
      "minimumSamples": 100,
      "version": "v1.0",
      "owner": "knowledge",
      "alertThreshold": "< 0.95",
      "rollbackCondition": "candidate release blocked"
    },
    {
      "metricId": "groundedness",
      "type": "diagnostic",
      "formula": "evidence_supported_claims / claims_requiring_evidence",
      "eligibleRequests": "RAG answers with claim annotations",
      "exclusions": ["opinions explicitly marked as such"],
      "window": "evaluation_run",
      "minimumSamples": 100,
      "version": "v1.0",
      "owner": "quality",
      "alertThreshold": "< 0.95",
      "rollbackCondition": "candidate release blocked"
    },
    {
      "metricId": "tool_selection_parameter_accuracy",
      "type": "diagnostic",
      "formula": "tasks_with_correct_tool_and_parameters / eligible_tool_tasks",
      "eligibleRequests": "frozen tool routing tasks",
      "exclusions": ["policy-denied tools"],
      "window": "evaluation_run",
      "minimumSamples": 50,
      "version": "v1.0",
      "owner": "runtime",
      "alertThreshold": "< 0.95",
      "rollbackCondition": "candidate release blocked"
    },
    {
      "metricId": "run_ttft_p95_ms",
      "type": "slo",
      "formula": "p95(run.started -> first answer.delta)",
      "eligibleRequests": "authenticated, non-rate-limited runs",
      "exclusions": ["主动取消", "策略拒绝"],
      "window": "rolling_1h",
      "minimumSamples": 30,
      "version": "v1.0",
      "owner": "platform",
      "alertThreshold": "> 2500ms",
      "rollbackCondition": "pause expensive rollout"
    },
    {
      "metricId": "run_duration_p95_ms",
      "type": "slo",
      "formula": "p95(run.started -> terminal event)",
      "eligibleRequests": "started runs requiring completion",
      "exclusions": ["主动取消", "非法输入"],
      "window": "rolling_1h",
      "minimumSamples": 30,
      "version": "v1.0",
      "owner": "platform",
      "alertThreshold": "> 30000ms",
      "rollbackCondition": "pause expensive rollout"
    },
    {
      "metricId": "cancel_effective_p95_ms",
      "type": "slo",
      "formula": "p95(cancel.accepted -> run.cancelled)",
      "eligibleRequests": "accepted cancel requests",
      "exclusions": ["already terminal"],
      "window": "rolling_1h",
      "minimumSamples": 20,
      "version": "v1.0",
      "owner": "runtime",
      "alertThreshold": "> 2000ms",
      "rollbackCondition": "pause run lifecycle rollout"
    },
    {
      "metricId": "tokens_consumed_total",
      "type": "cost",
      "formula": "sum(input_tokens + output_tokens)",
      "eligibleRequests": "model calls with usage metadata",
      "exclusions": ["redacted or missing usage"],
      "window": "rolling_1h",
      "minimumSamples": 1,
      "version": "v1.0",
      "owner": "platform",
      "alertThreshold": "baseline + 20%",
      "rollbackCondition": "throttle or downgrade model"
    },
    {
      "metricId": "cost_usd_total",
      "type": "cost",
      "formula": "sum(model_pricing(input_tokens, output_tokens))",
      "eligibleRequests": "model calls with a pinned price table",
      "exclusions": ["unknown model price"],
      "window": "rolling_1h",
      "minimumSamples": 1,
      "version": "v1.0",
      "owner": "platform",
      "alertThreshold": "baseline + 20%",
      "rollbackCondition": "throttle or downgrade model"
    }
  ]
}
