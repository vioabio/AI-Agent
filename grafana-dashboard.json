{
  "title": "VIO AI Agent - v1.0",
  "uid": "vio-ai-agent",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["vio", "agent", "v1.0"],
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "query": "label_values(up, application)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": ["$__all"]}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Run 终态成功/失败率",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"refId": "A", "expr": "sum(rate(vio_agent_run_total{status=\"completed\"}[5m]))", "legendFormat": "completed"},
        {"refId": "B", "expr": "sum(rate(vio_agent_run_total{status=~\"failed|timed_out\"}[5m]))", "legendFormat": "failed/timed_out"}
      ]
    },
    {
      "id": 2,
      "title": "Run P95 / TTFT P95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(vio_agent_run_duration_seconds_bucket[10m])) by (le))", "legendFormat": "run p95 (s)"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum(rate(vio_agent_ttft_seconds_bucket[10m])) by (le))", "legendFormat": "ttft p95 (s)"}
      ]
    },
    {
      "id": 3,
      "title": "活跃 Agent",
      "type": "stat",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "vio_agent_active", "legendFormat": "active"}]
    },
    {
      "id": 4,
      "title": "工具调用成功率",
      "type": "gauge",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"value": 0, "color": "red"}, {"value": 80, "color": "yellow"}, {"value": 95, "color": "green"}]}}},
      "targets": [{"refId": "A", "expr": "100 * sum(rate(vio_tool_call_success_total[5m])) / clamp_min(sum(rate(vio_tool_call_total[5m])), 1)", "legendFormat": "success %"}]
    },
    {
      "id": 5,
      "title": "检索空结果与反馈",
      "type": "timeseries",
      "gridPos": {"h": 5, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"refId": "A", "expr": "sum(rate(vio_retrieval_total{outcome=\"empty\"}[5m]))", "legendFormat": "retrieval empty"},
        {"refId": "B", "expr": "sum(rate(vio_feedback_total[5m]))", "legendFormat": "feedback"}
      ]
    },
    {
      "id": 6,
      "title": "Token 消耗",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 13},
      "targets": [{"refId": "A", "expr": "sum(rate(vio_tokens_consumed_total[5m]))", "legendFormat": "tokens/s"}]
    },
    {
      "id": 7,
      "title": "Prometheus Target",
      "type": "stat",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 13},
      "targets": [{"refId": "A", "expr": "up{job=\"vio-ai-agent\"}", "legendFormat": "vio-ai-agent"}]
    }
  ]
}
