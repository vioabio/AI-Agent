{
  "name": "vio-ai-agent-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "node scripts/run-quality-check.mjs lint",
    "typecheck": "node scripts/run-quality-check.mjs typecheck",
    "security:contract": "node scripts/security-contract-check.mjs",
    "test:contract": "node --test scripts/*.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "quality:frontend": "node scripts/run-frontend-quality.mjs",
    "version:check": "node scripts/version-registry-check.mjs",
    "preview": "vite preview",
    "openapi:fetch": "curl --fail --silent --show-error http://localhost:8123/api/v3/api-docs/default -o src/api/openapi.json",
    "openapi:gen": "openapi --input src/api/openapi.json --output src/api/generated --client axios --useOptions --useUnionTypes",
    "openapi:postgen": "node scripts/fix-openapi-gen.js",
    "openapi:sync": "node ../tools/sync-openapi-contract.mjs",
    "openapi:diff": "node ../tools/openapi-diff.mjs --base contracts/openapi-v1.0.json --candidate contracts/openapi-v1.1.json --report artifacts/v1.1/test/openapi-diff.json",
    "openapi:from-contract": "npm run openapi:sync && npm run openapi:gen && npm run openapi:postgen",
    "openapi": "npm run openapi:fetch && npm run openapi:gen && npm run openapi:postgen"
  },
  "dependencies": {
    "@vueuse/head": "^2.0.0",
    "axios": "^1.7.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "openapi-typescript-codegen": "^0.31.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vue-tsc": "^3.3.11"
  }
}
