{
  "schemaVersion": "v1.1",
  "policy": {
    "installMode": "explicit-only",
    "allowNetworkInstall": false,
    "missingDependencyStatus": "environment-pending",
    "missingDependencyExitCode": 2
  },
  "tools": {
    "lint": {
      "runner": "eslint",
      "packages": ["eslint", "@eslint/js", "eslint-plugin-vue", "globals"],
      "configs": ["eslint.config.js"]
    },
    "typecheck": {
      "runner": "vue-tsc",
      "packages": ["vue-tsc", "typescript"],
      "configs": ["tsconfig.json"]
    },
    "e2e": {
      "runner": "playwright",
      "packages": ["@playwright/test", "playwright"],
      "configs": ["playwright.config.js"],
      "requiredBrowser": true,
      "allowedTargets": ["local", "staging"]
    }
  }
}
