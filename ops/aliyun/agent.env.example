# Installed as /etc/vio-agent/agent.env; owned by root, mode 600.
# Enter the real key on the server. Do not upload your .run or application-local.yml.
DEEPSEEK_API_KEY=REPLACE_ON_SERVER
# Optional: set only when your account uses a different supported model.
# DEEPSEEK_MODEL=your-model-name
# Optional independent web search credential:
# SEARCH_API_KEY=REPLACE_ON_SERVER
# Keep a stable random cursor secret between releases (set during installation).
# VIO_RESOURCE_CURSOR_SECRET=GENERATED_ON_SERVER
