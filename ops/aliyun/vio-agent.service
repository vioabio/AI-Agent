[Unit]
Description=VIO Pokemon Agent single-server demonstration
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vioagent
Group=vioagent
WorkingDirectory=/var/lib/vio-agent
StateDirectory=vio-agent
StateDirectoryMode=0700
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/vio-agent/agent.env
ExecStart=/usr/bin/java -Xms256m -Xmx1536m -jar /opt/vio-agent/current/app.jar --spring.profiles.active=local,deepseek --spring.config.additional-location=file:/etc/vio-agent/application-public.yml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vio-agent
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
