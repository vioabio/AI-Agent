APP_ENV=development
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
# Set true only for temporary local debugging; normal logs mask candidate PII.
LOG_PII=false
ARTIFACTS_DIR=artifacts
LOGS_DIR=logs
DEVICE_ID=
ADB_EXECUTABLE=adb
LIEPIN_PACKAGE=
LIEPIN_MAIN_ACTIVITY=
# Stable operator-defined label such as recruiter_a; never store the login password here.
LIEPIN_ACCOUNT_ALIAS=

# Current project convention: use environment variables instead of hardcoding secrets.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=phone-rpa
MYSQL_CHARSET=utf8mb4

COZE_API_TOKEN=
COZE_API_BASE_URL=https://api.coze.cn
COZE_WORKFLOW_ID=
# Increment this whenever the Coze prompt, workflow logic, or score rubric changes.
COZE_ANALYSIS_VERSION=2026-08-10-daren-v3
FEISHU_BOT_WEBHOOK=
FEISHU_TEST_BOT_WEBHOOK=

# PDF upload uses strict SSH host-key verification. Password takes priority over private key.
PDF_UPLOAD_HOST=
PDF_UPLOAD_PORT=22
PDF_UPLOAD_USER=
PDF_UPLOAD_PASSWORD=
PDF_UPLOAD_PRIVATE_KEY=
PDF_UPLOAD_KNOWN_HOSTS=C:\Users\your-user\.ssh\known_hosts
PDF_UPLOAD_REMOTE_DIR=/opt/liepin_daily_report/search_pdf
PDF_PUBLIC_BASE_URL=

# Risk-control guards. Increase delays or lower limits if the platform becomes sensitive.
WORKFLOW_MIN_KEYWORD_DELAY_SECONDS=6
WORKFLOW_MAX_KEYWORD_DELAY_SECONDS=14
WORKFLOW_MAX_KEYWORDS_PER_RUN=
WORKFLOW_MAX_PROFILES_PER_KEYWORD=5
# false keeps the legacy exact brand+role card filter; true enables AI-first profile selection.
WORKFLOW_AI_FIRST_SELECTION=false
WORKFLOW_DAILY_KEYWORD_MIN=120
WORKFLOW_DAILY_KEYWORD_MAX=150
WORKFLOW_MAX_CONSECUTIVE_KEYWORD_ERRORS=8
WORKFLOW_DEVICE_HEARTBEAT_INTERVAL=5
WORKFLOW_LOCK_STALE_SECONDS=43200
DAILY_REPORT_WAIT_FOR_SEARCH_SECONDS=43200
