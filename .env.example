# ============================================================
# 📋 VIO AI Agent — 环境变量配置模板
# ============================================================
# 使用方法：
#   1. 复制此文件为 .env（.env 已在 .gitignore 中，不会被提交）
#      cp .env.example .env
#   2. 填入你的真实 API Key
#   3. （可选）source .env 或在 IDE 运行配置中设置
# ============================================================

# [必填] 阿里云百炼 DashScope API Key
# 获取地址：https://bailian.console.aliyun.com/
AI_DASHSCOPE_API_KEY=your-dashscope-api-key-here

# [必填] SearchAPI Key（用于联网搜索工具）
# 获取地址：https://www.searchapi.io/
SEARCH_API_KEY=your-searchapi-key-here

# [可选] 高德地图 API Key（用于 MCP 地图服务）
# 获取地址：https://lbs.amap.com/
AMAP_MAPS_API_KEY=your-amap-api-key-here

# [可选] Pexels API Key（用于 MCP 图片搜索服务）
# 获取地址：https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here

# [必填] 应用 API Key（生产 profile 的认证令牌）
VIO_API_KEY=replace-with-a-long-random-token
# 逗号分隔的可信反向代理 IP/CIDR；留空时忽略 X-Forwarded-For/X-Real-IP
VIO_TRUSTED_PROXY_CIDRS=
VIO_GLOBAL_QUOTA_ENABLED=false
# 可选：memory（本地）、jdbc（prod 过渡）或 redis（prod + Redis/Lua 验收后）
VIO_GLOBAL_QUOTA_BACKEND=memory
# backend=redis 时必填/按托管 Redis 端点覆盖；不要把真实密码写回仓库
VIO_REDIS_HOST=redis.example.internal
VIO_REDIS_PORT=6379
VIO_REDIS_USERNAME=
VIO_REDIS_PASSWORD=replace-with-redis-password
VIO_REDIS_CONNECT_TIMEOUT=2s
VIO_REDIS_TIMEOUT=2s
VIO_REDIS_SSL_ENABLED=true
# [生产必填] 资源分页游标签名密钥；不要提交真实值，建议由 Secret Store 注入
VIO_RESOURCE_CURSOR_SECRET=replace-with-a-long-random-cursor-secret
VIO_RESOURCE_CURSOR_TTL_SECONDS=900

# [生产必填] 反馈运营主体的稳定 principal（不是 API Key 本身）
# API Key 适配器当前派生非秘密数字 principal；可从认证日志/管理端映射后填写。
VIO_FEEDBACK_OPERATOR_ID=replace-with-operator-principal
VIO_FEEDBACK_OPERATOR_ROLE=operator

# [可选] 反馈模块和用户记忆开关；生产记忆默认关闭，启用前需完成密钥与持久化验收
VIO_FEEDBACK_ENABLED=true
VIO_FEEDBACK_REQUIRE_LINEAGE=false
VIO_MEMORY_ENABLED=false
VIO_MEMORY_ENCRYPTION_KEY=replace-with-base64-256-bit-memory-key
VIO_MEMORY_KEY_VERSION=v1
VIO_MEMORY_DEFAULT_TTL_DAYS=30

# [可选] 活动资讯 freshness 窗口（天）；生产 fixture 始终关闭
VIO_ACTIVITY_MAX_FRESHNESS_DAYS=7
VIO_ACTIVITY_FIXTURE_ENABLED=false

# [生产必填] v1.1 主链和 PGVector 必须显式开关，避免隐式启用
VIO_AGENT_V1_ENABLED=false
VIO_RAG_PGVECTOR_ENABLED=false
VIO_RAG_INGESTION_WORKER_ENABLED=false
VIO_RAG_INGESTION_WORKER_POLL_MS=1000
VIO_RAG_INGESTION_WORKER_BATCH_SIZE=1
VIO_RAG_INGESTION_OUTBOX_BATCH_SIZE=50

# [v1.1 非 Secret 环境契约] staging/发布时由环境或 Secret Store 注入
VIO_BASE_URL=http://localhost:8123/api
VIO_PROXY_BASE_URL=http://localhost:8123/api
VIO_PROMETHEUS_URL=http://localhost:9090
VIO_ALERTMANAGER_URL=http://localhost:9093
VIO_GRAFANA_URL=http://localhost:3001
VIO_EVAL_REVIEWER=local-reviewer
VIO_N3_RUN_ID=local-n3-pending
VIO_EVAL_RUN_DIR=artifacts/v1.1/eval
VIO_PUBLISHED_RELEASE_ID=local-not-published
VIO_TARGET_RPO_SECONDS=900
VIO_TARGET_RTO_SECONDS=1800
VIO_DEV_COMPOSE_PROJECT=vio-agent-dev
VIO_CANARY_COMPOSE_PROJECT=vio-agent-canary
VIO_RELEASE_COMPOSE_PROJECT=vio-agent-release
VIO_REGISTRY=registry.example.invalid/vio-ai-agent
VIO_COSIGN_IDENTITY=release@example.invalid
VIO_COSIGN_ISSUER=https://issuer.example.invalid

# [生产必填] 前端完整 origin 白名单（逗号分隔；禁止 '*'）
VIO_CORS_ALLOWED_ORIGINS=https://agent.example.com

# [生产必填] OIDC Authorization Code + PKCE 非 Secret 契约。
# 未配置完整 issuer/JWKS/audience/redirect 时 prod 应保持 fail-closed。
VIO_OIDC_ENABLED=false
VIO_OIDC_REQUIRED=true
VIO_OIDC_ISSUER_URI=https://id.example.com/realms/vio
VIO_OIDC_JWKS_URI=https://id.example.com/realms/vio/protocol/openid-connect/certs
VIO_OIDC_AUTHORIZATION_URI=https://id.example.com/realms/vio/protocol/openid-connect/auth
VIO_OIDC_TOKEN_URI=https://id.example.com/realms/vio/protocol/openid-connect/token
VIO_OIDC_AUDIENCE=vio-api
VIO_OIDC_CLIENT_ID=vio-web
# 只填 Secret Store 引用，不填 client secret 本身。
VIO_OIDC_CLIENT_SECRET_REF=secret://oidc/client-secret
VIO_OIDC_REDIRECT_URIS=https://agent.example.com/auth/callback
VIO_OIDC_REQUIRE_PKCE=true
VIO_OIDC_SESSION_IDLE_TIMEOUT_SECONDS=1800
VIO_OIDC_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
VIO_OIDC_COOKIE_SECURE=true
VIO_OIDC_COOKIE_SAME_SITE=Lax
VIO_OIDC_COOKIE_NAME=VIO_SESSION
VIO_OIDC_SUBJECT_CLAIM=sub
VIO_OIDC_ROLE_CLAIM=roles
VIO_OIDC_CLOCK_SKEW_SECONDS=60

# [必填] PostgreSQL 数据库密码（Compose 启动时无公开默认值）
DB_PASSWORD=your-db-password-here

# [monitoring profile 必填] Grafana 管理员密码
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password

# [可选] Grafana 用户名和 MCP 开关
GRAFANA_ADMIN_USER=admin
MCP_ENABLED=false
VIO_RESOURCE_DOWNLOAD_DIR=./tmp/download
VIO_RESOURCE_DOWNLOAD_MAX_BYTES=20971520
VIO_RESOURCE_DOWNLOAD_MAX_TOTAL_BYTES=104857600
VIO_RESOURCE_DOWNLOAD_ALLOWED_MEDIA_TYPES=image/,application/pdf,application/json,text/plain
VIO_RUN_DURABLE_RESUME=false
VIO_EVENT_BROKER_ENABLED=false
VIO_OUTBOX_POLL_MS=1000
VIO_RUN_LEASE_TTL_SECONDS=30
VIO_RUN_HEARTBEAT_SECONDS=10
VIO_EVENT_RETENTION_DAYS=30
VIO_EVENT_RETENTION_CLEANUP_ENABLED=false
VIO_EVENT_RETENTION_CLEANUP_INTERVAL_MS=3600000
VIO_EVENT_RETENTION_CLEANUP_BATCH_SIZE=1000

# [默认关闭] 可重放模型步骤的响应缓存；开启前必须接入 KMS/envelope codec。
VIO_MODEL_INVOCATION_CACHE_ENABLED=false
VIO_MODEL_INVOCATION_CACHE_FAIL_CLOSED=true
VIO_MODEL_INVOCATION_CACHE_STEP_NO=1
VIO_MODEL_INVOCATION_CACHE_TTL_SECONDS=3600
VIO_MODEL_VERSION=
VIO_PROMPT_VERSION=v1.1
