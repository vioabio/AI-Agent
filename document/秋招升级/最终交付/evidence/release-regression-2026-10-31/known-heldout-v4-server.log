双打以及天气和场地。若用户允许采用某些假设，应在结果旁明确列出，而不是把默认配置说成用户已经确认的事实。调用calculateBattleDamage成功后，再引用引擎版本、最小最大伤害、目标HP和百分比；工具失败时不能拿印象中的百分比补齐。","language":"zh-CN","battleFormatId":"casual-singles","rulesetVersionId":"casual-v1","validUntil":null,"provenance":{"kind":"PROJECT_NOTE","contentUsage":"ORIGINAL_NO_UPSTREAM_COPY","acquiredAt":"2026-10-23","reviewStatus":"PENDING_HUMAN_REVIEW","references":[{"title":"Smogon damage-calc项目接口说明","publisher":"Smogon damage-calc contributors","url":"https://github.com/smogon/damage-calc","checkedAt":"2026-10-23","relation":"ENGINE_INTERFACE_REFERENCE"}],"codeReferences":[{"path":"src/main/java/com/vio/vioaiagent/pokemon/engine/LocalDamageEngine.java","sha256":"32f1dee574465dd652fcce0933a70fda8b465abff962133905422413bc3a1efe"},{"path":"tools/pokemon-engine/calculate.cjs","sha256":"90e080660f1f4f65062358728d8448143a16e82adc148bcabc014af4512f3358"}]},"applicability":{"subjects":[],"topics":["damage"]}},"score":4731,"checksum":"sha256:bd79ff5a9c99bc64643b994b76d26c5d211729600ac90fa3b3132cf3628d94d4",...(truncated, total 7224 chars)
