为勤奋。这些是项目缺省值，不证明用户主动选择，也不是最优培养方案。招式、特性和道具为空仍是缺失条件。分析时应说明哪些配置已经保存，哪些只是缺省；用户没有确认低攻击或低速度个体值等条件时，不能替用户设定。","language":"zh-CN","battleFormatId":"casual-singles","rulesetVersionId":"casual-v1","validUntil":null,"provenance":{"kind":"PROJECT_NOTE","contentUsage":"ORIGINAL_NO_UPSTREAM_COPY","acquiredAt":"2026-10-23","reviewStatus":"PENDING_HUMAN_REVIEW","references":[],"codeReferences":[{"path":"src/main/java/com/vio/vioaiagent/pokemon/domain/TeamBuild.java","sha256":"03e80f52f6a583f8c00d5e60febc16763f9d2983d57462b2235c5237219d36e2"},{"path":"src/main/java/com/vio/vioaiagent/pokemon/engine/LocalDamageEngine.java","sha256":"32f1dee574465dd652fcce0933a70fda8b465abff962133905422413bc3a1efe"}]},"applicability":{"subjects":[],"topics":["training","project"]}},"score":3624,"checksum":"sha256:48fcf0dc827ab6c520c993413c019c7cf296aa357618a6cf7ab065319ada0399","citation":{"chunkId":"guide-4286999c0c167c8d5b6d700a6374aa8f9e2bbedc4076d9d21f180f71b506df2f","documentVersion":"sha256:2c2522ac12557b4d57530c496f95b797ff7f4e9ca8ddb3ce7642...(truncated, total 3293 chars)
