ect"]}},"score":12604,"checksum":"sha256:48fcf0dc827ab6c520c993413c019c7cf296aa357618a6cf7ab065319ada0399","citation":{"chunkId":"guide-461f739f9fa900fb24694afe2ab8ba21412d5c6a6becdeb5a9e8c9542ac789b4","documentVersion":"sha256:2c2522ac12557b4d57530c496f95b797ff7f4e9ca8ddb3ce7642ba37fa95abbd","chunkNo":1,"startOffset":137,"endOffset":295,"text":"项目数据对象在未提供时会采用等级50、性格hardy、努力值全0、个体值全31的填写默认值；hardy在界面中显示为勤奋。这些是项目缺省值，不证明用户主动选择，也不是最优培养方案。招式、特性和道具为空仍是缺失条件。分析时应说明哪些配置已经保存，哪些只是缺省；用户没有确认低攻击或低速度个体值等条件时，不能替用户设定。","contentHash":"sha256:25de286a17d1f23e2e7c4728d8cf864fe3b8d6288906e5c33df4a95a4ffc382f"}},{"document":{"id":"training-configuration-v1","title":"培养配置：性格、努力值与个体值","gameReleaseId":"pokemon-scarlet-violet","keywords":"培养 养成 努力值 个体值 EV IV 性格 nature 配招","author":"VIO project","updatedAt":"2026-10-20","sourceUrl":"","content":"这是项目原创的配置填写说明。保存配置前先明确输出方式和目标对手，再选择性格、等级、个体值和努力值。项目验证努力值单项不超过252、总和不超过510，个体值为0到31。不能仅凭这些边界就断言某种配置最优。性格、特性、道具和招式需要配合；低攻击个体值或低速度个体值属于特定战术条件，不应未经询问自动代入。初次分析应列出哪些是用户提供的条件、哪些是工具的默认条件，并询问未明确的赛制或配置。","language":"zh-CN","battleFormatId":"casual-singles","rulesetVersionId":"casual-v1","validUntil":null,"provenance":{"kind":"PROJECT_NOTE","contentUsage":"ORIGINAL_NO_UPSTREAM_COPY","acquiredAt":"2026-10-23","reviewStatus":"PENDING_HUMAN_REVIEW","references":[],"codeReferences":[{"path":"src/main/java/com/vio/vioaiagent/pokemon/domain/TeamBuild.java","sha256":"03e80f52f6a583f8c00d5e60febc16763f9d2983d57462b2235c5237219d36e2"}]},"applicability":{"subjects":[],"topics":["training"]}},"score":8556,"checksum":"sha256:a6843fc6e7d5f43c6848e242100da56e4307120714137de5e5910a833ca94592","citation":{"chunkId":"guide-2f54ab8c5292c79772e3495dee4bf48203109c70bbd8f7efbaf0413a32be9822","documentVersion":"sha256:990b0841d1b782a77aa9e0f5b698b403e7bdb83bfdec5f32cbe8e5e8b26a8274","chunkNo":0,"startOffset":0,"endOffset":192,"text":"这是项目原创的配置填写说明。保存配置前先明确输出方式和目标对手，再选择性格、等级、个体值和努力值。项目验证努力值单项不超过252、总和不超过510，个体值为0到31。不能仅凭这些边界就断言某种配置最优。性格、特性、道具和招式需要配合；低攻击个体值或低速度个体值属于特定战术条件，不应未经询问自动代入。初次分析应列出哪些是用户提供的条件、哪些是工具的默认条件，并询问未明确的赛制或配置。","contentHash":"sha256:0c23ddc8dd348678b83298b34307cf0a932fe926b7c0c05e0be04978ee48fade"}},{"document":{"id":"team-change-confirmation-v1","title":"从AI建议到队伍保存的确认流程","gameReleaseId":"pokemon-scarlet-violet","keywords":"队伍 修改 预览 确认 保存 取消 并发 冲突 等级","author":"VIO project","updatedAt":"2026-10-23","sourceUrl":"","content":"AI的建议与实际保存分为两个步骤。当前本地工作流先读取当前账号的指定队伍，再对现有成员的培养配置生成变更预览。预览列出修改前后内容，用户确认之前不写入保存队伍。聊天中说同意不是绕过确认接口的授权；真正保存必须走该预览关联的确认操作。当前流程不能借培养配置修改来偷偷增删成员或切换物种。\n\n预览关联队伍修订和有效期。用户取消、预览过期，或编辑区已经保存了新配置时，旧预览不能覆盖新状态；并发变化应提示冲突并重新分析。确认成功后应回读队伍，核对变动与预览一致，而不是仅靠模型一句已完成判断写入成功。这个流程不承诺服务重启后自动续跑，也不会把原文攻略里的命令句当成用户的保存指令。","language":"zh-CN","battleFormatId":"casual-singles","rulesetVersionId":"casual-v1","validUntil":null,"provenance":{"kind":"PROJECT_NOTE","contentUsage":"ORIGINAL_NO_UPSTREAM_COPY","acquiredAt":"2026-10-23","reviewStatus":"PENDING_HUMAN_REVIEW","references":[],"codeReferences":[{"path":"src/main/java/com/vio/vioaiagent/pokemon/team/TeamWorkflowService.java","sha256":"c3cc65687bbc5fbed3a98a68d4df37b160a0dc629d4f4ddded9dd9656d408b80"}]},"applicability":{"subjects":[],"topics":["project"]}},"score":1411,"checksum":"sha256:41c555cc67408cb4ddf470c23dc90bdec6230f4f330c8c33ba4762777eabb976","citation":{"chunkId":"guide-ef248d8303fab055bd6c49179810ca0be35fac5a5615b3460092d055533ff522","documentVersion":"sha256:83175ceac095f48bee8896bb5e6cbde7d8ad417c22c1b6a38eb14f023450c6ea","chunkNo":1,"startOffset":144,"endOffset":287,"text":"预览关联队伍修订和有效期。用户取消、预览过期，或编辑区已经保存了新配置时，旧预览不能覆盖新状态；并发变化应提示冲突并重新分析。确认成功后应回读队伍，核对变动与预览一致，而不是仅靠模型一句已完成判断写入成功。这个流程不承诺服务重启后自动续跑，也不会把原文攻略里的命令句当成用户的保存指令。","contentHash":"sha256:d820cfe8f51da68ee49319ad8cec7abd979e363831631dc7d7135fa35ba1ec4e"}}]], ToolResponse[id=call_01_CVBs3gbc5RAOIbwxw77A7001, name=searchPokemonGuides, responseData=[{"document":{"id":"build-values-and-defaults-v1","title":"种族值、实际配置与填写默认值","gameReleaseId":"pokemon-scarlet-violet","keywords":"种族值 实际能力 等级 默认 默认值 勤奋 hardy 努力值 个体值 性格","author":"VIO project